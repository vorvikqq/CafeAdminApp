@model List<CafeAdminApp.Models.ViewModels.OrderDetails>

<h2 class="text-center">Деталі замовлення "ID: @ViewData["OrderId"]"</h2>

@if (!Model.Any())
{
    @if (ViewData["Message"] != null)
    {
        <p class="text-center">@ViewData["Message"]</p>
        if (ViewData["Message"] == "Немає товарів у цьому замовленні.")
        {
            <div class="text-center mt-3">
                <button class="btn" style="background-color: #dc3545; color: white;" onclick="discardOrder()">Відхилити замовлення</button>
            </div>
        }
    }
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Назва товару</th>
                <th>Ціна (₴)</th>
                <th>Кількість</th>
                <th>Сума (₴)</th>
            </tr>
        </thead>
        <tbody>
            @{
                double totalOrderPrice = 0;
            }
            @foreach (var item in Model)
            {
                var productTotal = item.Price * item.Quantity;
                totalOrderPrice += productTotal;
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.Price</td>
                    <td>@item.Quantity</td>
                    <td>@productTotal</td>
                </tr>
            }
        </tbody>
    </table>

    <h4 class="text-right">До сплати: @totalOrderPrice ₴</h4>

    <div class="text-center mt-3">
        <button class="btn" style="background-color: #28a745; color: white;" onclick="acceptOrder()">Підтвердити замовлення</button>
        <button class="btn" style="background-color: #dc3545; color: white;" onclick="discardOrder()">Відхилити замовлення</button>
    </div>
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    function acceptOrder() {
        Swal.fire({
            title: 'Підтвердження',
            text: 'Ви впевнені, що хочете прийняти це замовлення?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Так',
            cancelButtonText: 'Ні',
            confirmButtonColor: '#28a745',  // зелений
            cancelButtonColor: '#dc3545',   // червоний
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = "@Url.Action("AcceptOrder", "Order", new { orderId = ViewData["OrderId"] })";
            }
        });
    }

    function discardOrder() {
        Swal.fire({
            title: 'Відхилити інвойс',
            text: 'Ви впевнені, що хочете відхилити це замовлення?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Так',
            cancelButtonText: 'Ні',
            сonfirmButtonColor: '#28a745',  // зелений
            cancelButtonColor: '#dc3545',   // червоний
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = "@Url.Action("DiscardOrder", "Order", new { orderId = ViewData["OrderId"] })";
            }
        });
    }
</script>